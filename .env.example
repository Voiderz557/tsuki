# TSUKI environment variables
#
# Not required yet for Milestone 1 (static homepage with placeholder data).
# These are placeholders for upcoming milestones — copy this file to
# `.env.local` and fill in real values when wiring up the corresponding
# feature. Never commit `.env.local` or any file containing real secrets.

# --- Milestone 2: AniList ---------------------------------------------------
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"

# --- Milestone 3: Database (Supabase Postgres) via Prisma -------------------
DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Milestone 3: Auth.js ---------------------------------------------------
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"

# --- Milestone 3 (optional social auth, added later) ------------------------
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""
